<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- One file per Deckfmt wire-format version, see Deckfmt/DeckfmtConfig.cs. -->
    <EmbeddedResource Include="Deckfmt\Config\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- GameApi.Tests lives under this project's directory, so the default
         recursive item globs above would otherwise also pull its files into
         this project's compilation. -->
    <Compile Remove="GameApi.Tests/**" />
    <Content Remove="GameApi.Tests/**" />
    <EmbeddedResource Remove="GameApi.Tests/**" />
    <None Remove="GameApi.Tests/**" />
  </ItemGroup>

</Project>
